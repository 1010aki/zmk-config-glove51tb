#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors/rgbled_widget.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Layer Numbering

#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        scroll {
            bindings = <&mo 5>;
            key-positions = <35 36>;
        };
    };

    behaviors {
        sensor_rotate_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_wheel_scroll: mouse_wheel_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        new_behavior: new_behavior {
            compatible = "zmk,behavior-key-repeat";
            label = "NEW_BEHAVIOR";
            #binding-cells = <0>;
            usage-pages = 3;
        };
    };

    macros {
        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";
            bindings = <
&kp ESC         &kp Q    &kp W       &kp F         &kp P                &kp B                                                   &kp J            &kp L  &kp U      &kp Y    &kp SEMI  &kp DEL
&kp MINUS       &kp A    &kp R       &kp S         &kp T                &kp G      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp M            &kp N  &kp E      &kp I    &kp O     &kp APOS
&kp LEFT_SHIFT  &kp Z    &kp X       &kp C         &kp D                &kp V      &kp LBKT              &kp RBKT               &kp K            &kp H  &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
&kp LEFT_WIN    &kp F21  &kp C_MENU  &kp LEFT_ALT  &mt LCTRL LA(GRAVE)  &lt 1 TAB  &kp SPACE             &lt 4 ENTER            &lt 2 BACKSPACE                             &kp F21   &to 1
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
&trans  &kp QUESTION  &kp AMPERSAND  &kp HASH   &kp PERCENT  &trans                     &kp PAGE_UP    &kp N6  &kp N7  &kp N8  &kp N9  &trans
&trans  &kp AT        &kp STAR       &kp PLUS   &kp TILDE    &kp GRAVE  &trans  &trans  &kp PAGE_DOWN  &kp N2  &kp N3  &kp N4  &kp N5  &trans
&trans  &kp EQUAL     &kp EXCL       &kp CARET  &kp DOLLAR   &kp PIPE   &trans  &trans  &trans         &kp N1  &trans  &trans  &trans  &trans
&trans  &trans        &trans         &trans     &trans       &trans     &trans  &kp N0  &trans                                 &trans  &trans
            >;
        };

        navigation_layer {
            label = "NAV";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &kp PAGE_UP      &kp HOME  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp END    &kp LA(F4)
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp PAGE_DOWN    &kp LEFT  &kp DOWN         &kp UP             &kp RIGHT  &kp LC(W)
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp PRINTSCREEN  &kp F15   &kp F16          &kp F17            &kp F18    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                                         &trans     &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4                     &kp C_VOLUME_UP    &kp F6  &kp F7   &kp F8   &kp F9  &trans
&trans  &trans        &trans        &trans        &bt BT_CLR_ALL  &bt BT_CLR    &trans    &trans   &kp C_VOLUME_DOWN  &kp F2  &kp F3   &kp F4   &kp F5  &trans
&trans  &trans        &trans        &trans        &trans          &ind_con      &ind_bat  &trans   &kp K_MUTE         &kp F1  &kp F11  &kp F12  &trans  &trans
&trans  &trans        &trans        &trans        &trans          &trans        &trans    &kp F10  &trans                                       &trans  &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &to 0      &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                   &trans  &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans
            >;
        };
    };
};
