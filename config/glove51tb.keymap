#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors/rgbled_widget.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Layer Numbering

#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

&lt {
    flavor = "hold-preferred";
    tapping-term-ms = <150>;
    quick-tap-ms = <150>;
};

&mt {
    flavor = "hold-preferred";
    tapping-term-ms = <150>;
    quick-tap-ms = <150>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        scroll {
            bindings = <&mo 5>;
            key-positions = <35 36>;
        };
    };

    behaviors {
        sensor_rotate_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_wheel_scroll: mouse_wheel_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        colon_semicolon: colon_semicolon {
            compatible = "zmk,behavior-mod-morph";
            label = "COLON_SEMICOLON";
            bindings = <&kp COLON>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";
            bindings = <
&kp ESC               &kp Q                     &kp W               &kp F         &kp P          &kp B                                                   &kp J            &kp L  &kp U      &kp Y    &kp SEMI                  &kp DEL
&mt LEFT_SHIFT MINUS  &kp A                     &kp R               &kp S         &kp T          &kp G      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp M            &kp N  &kp E      &kp I    &kp O                     &mt RIGHT_SHIFT SQT
&kp LEFT_WIN          &kp Z                     &kp X               &kp C         &kp D          &kp V      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp K            &kp H  &kp COMMA  &kp DOT  &kp FSLH                  &kp TAB
&to 1                 &mt F21 LC(LEFT_BRACKET)  &kp K_CONTEXT_MENU  &kp LEFT_ALT  &mt LCTRL F23  &lt 1 F24  &kp SPACE             &lt 3 ENTER            &lt 2 BACKSPACE                             &mt F21 LC(LEFT_BRACKET)  &kp F19
            >;

            sensor-bindings = <&mouse_wheel_scroll SCRL_UP SCRL_DOWN>;
        };

        number_layer {
            label = "NUM";
            bindings = <
&trans  &trans           &kp AMPERSAND  &kp HASH   &kp PERCENT  &kp BACKSLASH                  &kp PG_UP      &kp N6        &kp N7        &kp N8        &kp N9  &trans
&trans  &kp AT           &kp ASTERISK   &kp PLUS   &kp TILDE    &kp GRAVE      &trans  &trans  &kp PAGE_DOWN  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5  &trans
&trans  &kp EXCLAMATION  &kp QUESTION   &kp CARET  &kp DOLLAR   &kp PIPE       &trans  &trans  &trans         &kp NUMBER_1  &trans        &trans        &trans  &kp EQUAL
&to 0   &trans           &trans         &trans     &trans       &trans         &trans  &kp N0  &trans                                                   &trans  &trans
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4                               &kp F1           &kp F6   &kp F7   &kp F8              &kp F9                    &trans
&trans  &trans        &trans        &trans        &bt BT_CLR_ALL  &bt BT_CLR    &trans    &kp C_MUTE         &kp F10          &kp F2   &kp F3   &kp F4              &kp F5                    &trans
&trans  &trans        &trans        &trans        &trans          &ind_con      &ind_bat  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp F11  &kp F12  &kp LG(LC(LA(N0)))  &kp LG(LC(LA(NUMBER_1)))  &kp LG(LC(LA(NUMBER_2)))
&trans  &trans        &trans        &trans        &trans          &trans        &trans    &trans             &trans                                                 &trans                    &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&trans  &trans           &trans        &trans   &trans   &trans                        &trans       &kp PAGE_UP     &kp UP_ARROW    &kp PAGE_DOWN    &trans   &kp LA(F4)
&trans  &kp EXCLAMATION  &kp QUESTION  &kp F24  &kp F23  &trans  &kp F19  &trans       &kp HOME     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END  &kp LC(W)
&trans  &kp EXCLAMATION  &kp QUESTION  &trans   &trans   &trans  &kp F20  &kp LG(TAB)  &kp LA(TAB)  &kp F15         &kp F16         &kp F17          &kp F18  &kp PRINTSCREEN
&trans  &trans           &trans        &trans   &trans   &trans  &trans   &trans       &trans                                                        &trans   &trans
            >;

            sensor-bindings = <&sensor_rotate_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &kp LA(UP_ARROW)  &kp LA(LEFT_ARROW)  &mkp MCLK  &kp LA(RIGHT_ARROW)  &kp LC(T)          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(PAGE_UP)   &mkp LCLK           &to 0      &mkp RCLK            &kp LC(PAGE_DOWN)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans              &trans     &trans               &trans             &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                                                &trans             &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&kp N1  &kp Q   &kp W   &kp F   &kp P   &kp B                   &kp J   &kp L  &kp U      &kp Y    &kp N2    &kp N3
&kp N4  &kp A   &kp R   &kp S   &kp T   &kp G   &trans  &trans  &kp M   &kp N  &kp E      &kp I    &kp O     &kp MINUS
&kp N5  &kp Z   &kp X   &kp C   &kp D   &kp V   &trans  &trans  &kp K   &kp H  &kp COMMA  &kp DOT  &kp FSLH  &kp N7
&to 0   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                             &trans    &trans
            >;
        };
    };
};
